# do not edit this file, it will be overwritten on update

ACTION=="remove", GOTO="qubes-ignore-devices-end"
SUBSYSTEM!="block", GOTO="qubes-ignore-devices-end"
KERNEL=="loop*", ENV{DM_UDEV_DISABLE_DISK_RULES_FLAG}="1", ENV{UDEV_DISABLE_PERSISTENT_STORAGE_RULES_FLAG}="1", GOTO="qubes-devices-check-export"
KERNEL=="xvd*", ENV{DM_UDEV_DISABLE_DISK_RULES_FLAG}="1", ENV{UDEV_DISABLE_PERSISTENT_STORAGE_RULES_FLAG}="1"
# ENV{DM_NAME} not available yet
# Template VM disks
ATTR{dm/name}=="snapshot-*", ENV{DM_UDEV_DISABLE_DISK_RULES_FLAG}="1"
ATTR{dm/name}=="origin-*", ENV{DM_UDEV_DISABLE_DISK_RULES_FLAG}="1"
# Encrypted volatile volumes
ATTR{dm/name}=="*@crypt", ENV{DM_UDEV_DISABLE_DISK_RULES_FLAG}="1"
ATTR{dm/name}=="vm-volatile-*", ENV{DM_UDEV_DISABLE_DISK_RULES_FLAG}="1"
# kpartx used for creating empty volatile.img, udevd tries to access the device
# and prevent kpartx from removing them
ATTR{dm/name}=="loop*p*", ENV{DM_UDEV_DISABLE_DISK_RULES_FLAG}="1"

GOTO="qubes-ignore-devices-end"

LABEL="qubes-devices-check-export"
TEST!="loop/backing_file", GOTO="qubes-ignore-devices-end"

# Export all loop devices backed by files that do not belong to Qubes VMs.
ATTR{loop/backing_file}!="*/appvms/*/*.img*|*/vm-templates/*/*.img*", ENV{QUBES_EXPORT_BLOCK_DEVICE}="1", GOTO="qubes-ignore-devices-end"

# Set the name of the VM that owns this image file.
PROGRAM=="/bin/sh -c 'V=$attr{loop/backing_file}; V=$${V##*/appvms/}; V=$${V##*/vm-templates/}; echo $${V%%/*}", ENV{.QUBES_VM}="%c"
# If the VM owning the image is halted, allow the loop device backed by the
# image to be available for attaching to other VMs.
PROGRAM=="/bin/sh -c 'qvm-ls --raw-data --halted \"$env{.QUBES_VM}\" | grep -q .'", ENV{QUBES_EXPORT_BLOCK_DEVICE}="1"

LABEL="qubes-ignore-devices-end"

# vim: set ft=udevrules ff=unix fenc=UTF-8 eol:
